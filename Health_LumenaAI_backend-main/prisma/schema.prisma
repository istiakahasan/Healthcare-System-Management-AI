model Shift {
  id            String      @id @default(auto()) @map("_id") @db.ObjectId
  carePlanId    String      @db.ObjectId
  carePlan      CarePlan    @relation(fields: [carePlanId], references: [id], onDelete: Cascade)
  patientId     String      @db.ObjectId
  patient       Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  staffId       String?     @db.ObjectId // Add ? to make it optional
  staff         Staff?      @relation(fields: [staffId], references: [id], onDelete: Cascade) // Add ? here too
  shiftType     ShiftType
  isNotified    Boolean     @default(false)
  startDateTime DateTime
  endDateTime   DateTime
  status        ShiftStatus @default(SCHEDULED)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model ShiftRequest {
  id                 String             @id @default(auto()) @map("_id") @db.ObjectId
  carePlanId         String             @db.ObjectId
  carePlan           CarePlan           @relation(fields: [carePlanId], references: [id], onDelete: Cascade)
  requestedBy        String             @db.ObjectId
  requester          Customer           @relation(fields: [requestedBy], references: [id], onDelete: Cascade)
  shiftRequestStatus ShiftRequestStatus @default(PENDING)
  declineReason      String?
  staffId            String             @db.ObjectId
  staff              Staff              @relation(fields: [staffId], references: [id], onDelete: Cascade)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model ShiftNote {
  id             String          @id @default(auto()) @map("_id") @db.ObjectId
  title          String // Flexible structure for various activity types and details
  incident       String
  concern        String? // Any issues or concerns during shift
  rawNotes       String
  aiSummary      String?
  aiImageSummary String?
  image          String?
  adminNote      String?
  NDISVerified   Boolean         @default(false)
  status         ShiftNoteStatus @default(PENDING)

  staffId String @db.ObjectId
  staff   User   @relation(fields: [staffId], references: [id], onDelete: Cascade)

  patientId  String   @db.ObjectId
  patient    Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  customerId String   @db.ObjectId
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // staff     Staff    @relation(fields: [staffId], references: [id])
}

model Staff {
  id                  String              @id @default(auto()) @map("_id") @db.ObjectId
  age                 Int
  availabilityHours   String // General availability description
  bio                 String?
  certifications      String[]
  dayOfWeek           DayOfWeek[]         @default([]) // Specific available days
  endTime             String?
  experienceYears     Int?
  hourlyRate          String
  languages           LanguageEnum[]      @default([])
  serviceCategory     ServiceCategory[]   @default([])
  shiftType           ShiftType[]         @default([])
  skills              SupportActivity[]   @default([])
  staffStatus         StaffStatus         @default(INACTIVE)
  serviceAvailability ServiceAvailability @default(IMMEDIATE)
  startTime           String?
  totalWorkTime       String? //in hrs
  travelDistance      TravelDistance      @default(WITHIN_20_KM)
  userId              String              @unique @db.ObjectId
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  // reviews             Review[]
  reviews             Review[]            @relation("StaffReviews")
  NDISClaim           NDISClaim[]
  qualification       Qualification?
  Shift               Shift[]
  ShiftRequest        ShiftRequest[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  // shiftNotes          ShiftNote[]

}

model User {
  id                  String                @id @default(auto()) @map("_id") @db.ObjectId
  about               String?
  canResetPassword    Boolean               @default(false) // Password reset permissions
  email               String                @unique
  fcmToken            String? // Firebase Cloud Messaging for push notifications
  firstName           String
  gender              GenderEnum
  isDeleted           Boolean               @default(false) // Soft delete flag
  isResetPassword     Boolean               @default(false) // Temporary reset state
  isVerified          Boolean               @default(false) // Email/phone verification
  isBlocked           Boolean               @default(false) // Account block status
  lastName            String
  password            String?
  phoneNumber         String?
  profileImage        String                @default("")
  role                UserRole              @default(CUSTOMER)
  status              UserStatus            @default(ACTIVE)
  portalSettings      Json? // Flexible user preferences for portal customization
  bookings            Booking[]
  contactSupports     ContactSupport[]
  customer            Customer?
  OTP                 OTP?
  reviews             Review[]
  staff               Staff?
  documents           Document[]
  address             Address[]
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  ChatRoom            ChatRoom[]
  ChatRoomParticipant ChatRoomParticipant[]
  Chat                Chat[]
  shiftNotes          ShiftNote[]

  @@index([email, status]) // User lookup and management
  @@index([role, isDeleted]) // Administrative queries
}

// ENUM DEFINITIONS (Alphabetical Order)

enum CareNeedStatus {
  PREDICTED // AI-identified but not confirmed
  CONFIRMED // Validated by care team
  SCHEDULED // Care scheduled
  IN_PROGRESS // Active care
  COMPLETED // Care delivered
  CANCELLED // No longer needed
}

enum CareNeedType {
  PERSONAL_CARE
  MEDICAL
  BEHAVIORAL
  SOCIAL
  THERAPY
  NUTRITION
  MOBILITY
}

enum CarePlanStatus {
  ACTIVE
  COMPLETED
  INACTIVE
}

enum ClaimStatus {
  DRAFT
  SUBMITTED
  VALIDATED
  REJECTED
  APPROVED
  PAID
}

enum Currency {
  EUR
  GBP
  LYD
  USD
}

enum DayOfWeek {
  FRIDAY
  MONDAY
  SATURDAY
  SUNDAY
  THURSDAY
  TUESDAY
  WEDNESDAY
}

